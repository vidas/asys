{
  "name": "@asys/bpmn",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Run BPMN workflows with agents and human tasks in a reusable dcomp component",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./client": "./src/client.mjs",
    "./contract": "./gen/asys/workflow/v1/workflow_pb.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:diagrams": "node --test test/diagrams/*.test.mjs",
    "generate": "buf lint && buf generate",
    "build": "make build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@dcomp/component": "file:../asys-inference/components/vendor/dcomp-component",
    "bpmn-elements": "17.3.0",
    "bpmn-moddle": "9.0.4",
    "feelin": "7.0.1",
    "moddle-context-serializer": "4.4.1",
    "moddle-xml": "11.0.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "bpmn-js": "18.28.0",
    "playwright-core": "1.63.0"
  }
}
