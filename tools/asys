#!/usr/bin/env python3
"""Configure asys, update shared services, and inspect runs and jobs."""
from pathlib import Path
import sys

executable = Path(__file__).resolve()
for directory in (executable.parents[1] / 'share/asys/vendor', executable.parents[1] / '.host-deps'):
    if directory.is_dir():
        sys.path.insert(0, str(directory))
if (executable.parents[1] / 'asys-runtime').is_dir():
    sys.path.insert(0, str(executable.parents[1] / 'asys-runtime'))
for directory in (executable.parents[1] / "share/asys/python", executable.parents[1] / "python"):
    if (directory / "asys/runs.py").is_file():
        sys.path.insert(0, str(directory))
        break
try:
    from asys.cli import main
except ImportError as error:
    raise SystemExit(f"asys needs its installed Python package: {error}")


if __name__ == "__main__":
    sys.exit(main())
