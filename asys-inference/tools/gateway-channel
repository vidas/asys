#!/usr/bin/env python3
"""Private host client for the gateway's asys-runtime channel."""

import argparse
import json
import os
from pathlib import Path
import select
import signal
import sys
import termios
import time
import uuid

location = Path(__file__).resolve()
for root in (location.parent / "python", location.parents[2] / "asys-runtime"):
    if (root / "asys_runtime/channel.py").is_file():
        sys.path.insert(0, str(root))
        break
from asys_runtime.channel import Reader, Writer, direction_root


class Terminal:
    """Read lines without blocking the channel watcher; restore echo on every exit."""
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.saved = None
        self.buffer = b""
        self.prompt = None

    def open(self, prompt, visible):
        if self.prompt is not None:
            raise ValueError("Gateway requested simultaneous terminal prompts")
        self.prompt = prompt
        if visible:
            print(prompt["message"], end="", file=sys.stderr, flush=True)
        if prompt["secret"] and os.isatty(self.fd):
            self.saved = termios.tcgetattr(self.fd)
            hidden = list(self.saved)
            hidden[3] &= ~termios.ECHO
            termios.tcsetattr(self.fd, termios.TCSANOW, hidden)

    def poll(self):
        if self.prompt is None:
            return None
        if b"\n" not in self.buffer:
            if not select.select([self.fd], [], [], 0)[0]:
                return None
            data = os.read(self.fd, 4096)
            if not data and not self.buffer:
                raise ValueError("No answer on stdin")
            self.buffer += data or b"\n"
            if len(self.buffer) > 65536:
                raise ValueError("Authentication answer exceeds 64 KiB")
        if b"\n" not in self.buffer:
            return None
        line, self.buffer = self.buffer.split(b"\n", 1)
        prompt = self.prompt
        self.close()
        return prompt, line.rstrip(b"\r").decode("utf-8")

    def close(self, cancelled=False):
        if cancelled:
            self.buffer = b""
            if self.prompt is not None and os.isatty(self.fd):
                termios.tcflush(self.fd, termios.TCIFLUSH)
        if self.saved is not None:
            termios.tcsetattr(self.fd, termios.TCSANOW, self.saved)
            self.saved = None
            print(file=sys.stderr, flush=True)
        self.prompt = None


def request(root, command, body, *, api_key_env=None):
    outgoing = Writer(direction_root(root, "gateway", "in"))
    incoming = Reader(direction_root(root, "gateway", "out"))
    terminal = Terminal()
    identifier = uuid.uuid4().hex
    parent = os.getppid()
    interrupted = False

    def interrupt(_signum, _frame):
        nonlocal interrupted
        interrupted = True

    previous = {s: signal.signal(s, interrupt) for s in (signal.SIGINT, signal.SIGTERM)}
    started = completed = False
    seed = os.environ.get(api_key_env) if api_key_env else None
    used_key = False
    try:
        if api_key_env and not seed:
            raise ValueError("API-key environment variable is empty")
        after = incoming.last()
        if not after:
            raise ValueError("Gateway channel is not ready; run start")
        instance = incoming.event(after)["data"].get("instance")
        if not instance:
            raise ValueError("Gateway channel has no running instance; run start")
        outgoing.send("request", {"id": identifier, "instance": instance, "command": command, "body": body})
        started = True
        last_reply = last_keepalive = time.monotonic()
        deadline = last_reply + 30 if command != "login" else float("inf")
        while True:
            now = time.monotonic()
            if interrupted or os.getppid() != parent:
                raise KeyboardInterrupt()
            if now > deadline or now - last_reply > 20:
                raise ValueError("Gateway stopped responding")
            for event in incoming.read(after):
                after = event["sequence"]
                data = event["data"]
                if data.get("instance") != instance:
                    raise ValueError("Gateway restarted; retry the command")
                if data.get("id") == identifier:
                    last_reply = now
                    kind = event["type"]
                    if kind == "notice":
                        print(data["message"], file=sys.stderr, flush=True)
                    elif kind == "prompt":
                        if not body.get("interactive"):
                            if not data["secret"] or used_key or body.get("authentication") == "oauth":
                                raise ValueError("This login requires interactive input; use a terminal")
                            used_key = True
                            if seed is not None:
                                outgoing.send("answer", {"id": identifier, "prompt": data["prompt"], "value": seed})
                                seed = None
                                continue
                        terminal.open(data, bool(body.get("interactive")))
                    elif kind == "prompt.cancelled":
                        if terminal.prompt and terminal.prompt["prompt"] == data["prompt"]:
                            terminal.close(cancelled=True)
                    elif kind in ("result", "error"):
                        incoming.advance(after)
                        incoming.prune()
                        completed = True
                        if kind == "error":
                            raise ValueError(data["message"])
                        return data["result"]
                incoming.advance(after)
            incoming.prune()
            answer = terminal.poll()
            if answer is not None:
                prompt, value = answer
                outgoing.send("answer", {"id": identifier, "prompt": prompt["prompt"], "value": value})
            if now - last_keepalive >= 1:
                outgoing.send("keepalive", {"id": identifier})
                last_keepalive = now
            time.sleep(0.025)
    finally:
        terminal.close(cancelled=True)
        if started and not completed:
            outgoing.send("cancel", {"id": identifier})
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("root", type=Path)
    parser.add_argument("command", choices=["providers", "models", "usage", "status", "login", "logout", "rename"])
    parser.add_argument("body", type=json.loads)
    parser.add_argument("--api-key-env")
    args = parser.parse_args()
    result = request(args.root, args.command, args.body, api_key_env=args.api_key_env)
    print(json.dumps(result, indent=2), flush=True)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Login cancelled", file=sys.stderr)
        raise SystemExit(130)
    except (OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
