#!/usr/bin/env python3
"""Exercise the terminal handler and Human bridge in an isolated dcomp system."""
import asyncio
import fcntl
import json
import os
from pathlib import Path
import pty
import shutil
import signal
import sqlite3
import struct
import subprocess
import sys
import tempfile
import termios
import time
import uuid

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT.parent / "python"), str(ROOT.parent / "asys-runtime")]
from asys_runtime import Queue, release


class HumanQueue(Queue):
    def __init__(self, root, jobs, workspace):
        super().__init__(root)
        self.job_records = jobs
        self.workspace = workspace

    def submit(self, job_type, job_id, **options):
        directory = self.job_records / job_id
        directory.mkdir()
        return super().submit(job_type, job_id, directory=directory, workspace=self.workspace, **options)


def main():
    with tempfile.TemporaryDirectory(prefix="asys-human-it-") as temporary:
        temp = Path(temporary)
        system = "human-test-" + uuid.uuid4().hex[:10]
        update_system = system + '-update'
        dcomp = [os.environ.get("DCOMP_BINARY", "dcomp"), "--state-root", str(temp / "dcomp")]
        log = temp / "commands.log"
        processes = []
        current_handler_root = temp / 'first/human'
        human_image = 'asys-human-update-test:' + uuid.uuid4().hex[:10]

        def run(command, *args):
            result = subprocess.run(command + list(args), capture_output=True, text=True, timeout=180)
            with log.open("a") as output:
                output.write(f"{command + list(args)}\n{result.stdout}{result.stderr}\n")
            if result.returncode:
                raise AssertionError(f"Command failed: {command + list(args)}\n{result.stdout[-1000:]}{result.stderr[-3000:]}")
            return result.stdout

        def until(check, timeout=60):
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                result = check()
                if result:
                    return result
                time.sleep(0.05)
            raise AssertionError(f"Timed out\n{log.read_text()[-3000:]}")

        def components():
            return {item["name"]: item for item in json.loads(run(dcomp, "view", "--json", system))["components"]}

        def add_worker(name):
            definition = temp / name
            definition.mkdir()
            worker_image = os.environ.get("ASYS_WORKERS_IMAGE") or release.image("asys-workers")[0]
            (definition / "component.dcomp").write_text(f"docker {worker_image}\ninput asys.human.v1.Human human\n")
            (definition / "workers.json").write_text(json.dumps({"version": 1, "name": name,
                "types": {"human": {"command": ["/opt/asys/asys-workers/tools/asys-human"]}}}))
            state = temp / f"{name}-state"
            runtime, jobs = state / "runtime", state / "jobs"
            workspace = temp / f"{name} project"
            for path in (runtime, jobs, workspace):
                path.mkdir(parents=True)
            (state / "workspace").symlink_to(workspace, target_is_directory=True)
            (workspace / "review.md").write_text(f"# {name} project\n\nReview the actual workspace.")
            run(dcomp, "add-component", "--user", f"{os.getuid()}:{os.getgid()}",
                "--bind", f"{definition},/opt/asys/environment,ro",
                "--bind", f"{runtime},/var/lib/asys/runtime,rw",
                "--bind", f"{jobs},/var/lib/asys/jobs,rw",
                "--bind", f"{workspace},/var/lib/asys/workspace,rw", "--link", "human=@human_endpoint", system, name, str(definition))
            # Store the same relative workspace reference used by real launchers.
            return HumanQueue(runtime / "environments" / name, jobs, state / "workspace")

        def launch(label, extra=()):
            output = temp / f"{label}.log"
            with output.open("w") as stream:
                process = subprocess.Popen([sys.executable, str(ROOT / "tools/asys-human-prompt"), "--system", system,
                    "--dcomp-state-root", str(temp / "dcomp"), "--root", str(current_handler_root.parent), "--claimant", "alice", *extra],
                    stdin=subprocess.PIPE, stdout=stream, stderr=stream, text=True,
                    env=os.environ)
            processes.append(process)
            def contains(needle):
                if process.poll() is not None:
                    raise AssertionError(f"Handler exited: {process.returncode}\n{output.read_text()}")
                return needle in output.read_text()
            return process, output, contains

        def human_state(queue, id):
            paths = list(current_handler_root.glob('*/runtime/tasks.sqlite'))
            if not paths:
                return {'status': 'pending'}
            with sqlite3.connect(paths[0]) as database:
                row = database.execute('SELECT record FROM tasks WHERE id = ?', (f'{queue.root.name}.{id}',)).fetchone()
            return json.loads(row[0])['state'] if row else {'status': 'pending'}

        try:
            # The test installs its own Human image through a private release,
            # exactly as make install records one.
            installed = release.load()
            run(['docker'], 'tag', release.image('asys-human-interface', installed)[0], human_image)
            test_release = temp / 'release.json'
            shutil.copyfile(release.release_path(), test_release)
            def install_human():
                release.record(test_release, 'asys-human-interface', human_image,
                               version=installed['version'], build=installed['build'])
            install_human()
            os.environ['ASYS_RELEASE'] = str(test_release)
            empty = temp / 'system.dcomp'
            empty.write_text(f'system {system}\n')
            run(dcomp, 'up', str(empty))
            # Exercise the user's ordering: launch a workflow before any human
            # terminal exists. The service must queue its request independently.
            early_environment = temp / 'early-environment'
            shutil.copytree(ROOT.parent / 'asys-bpmn/examples/human-prompt/env/human', early_environment)
            (early_environment / 'component.dcomp').write_text('docker early-human\noutput asys.human.v1.Human human\n')
            early_workflow = temp / 'early.bpmn'
            early_workflow.write_text('''<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
              xmlns:asys="urn:asys:workflow:1" targetNamespace="urn:test">
              <bpmn:process id="early" isExecutable="true"><bpmn:userTask id="approval">
                <bpmn:extensionElements><asys:job type="human" input='= {prompt: "Queued before a terminal?", form: {type: "boolean"}}'/></bpmn:extensionElements>
              </bpmn:userTask></bpmn:process></bpmn:definitions>''')
            early_log = temp / 'early.log'
            with early_log.open('w') as output:
                early = subprocess.Popen([sys.executable, str(ROOT.parent / 'tools/asys-run'),
                    str(early_environment), str(early_workflow), '--root', str(temp / 'first'),
                    '--workspace', str(temp), '--system', system, '--dcomp-state-root', str(temp / 'dcomp')],
                    stdin=subprocess.DEVNULL, stdout=output, stderr=output, text=True,
                    env={**os.environ, 'ASYS_STATE_ROOT': str(temp / 'first')})
            processes.append(early)
            def queued_before_terminal():
                assert early.poll() is None, early_log.read_text()
                paths = list(current_handler_root.glob('*/runtime/tasks.sqlite'))
                if not paths:
                    return False
                with sqlite3.connect(paths[0]) as database:
                    return database.execute('SELECT count(*) FROM tasks').fetchone()[0] == 1
            until(queued_before_terminal, timeout=120)
            shared_name = 'asys-human'
            shared_id = components()[shared_name]['status']['container_id']
            assert not list(current_handler_root.glob('*/session.json')), 'no terminal has been started'
            first, first_log, first_contains = launch("first")
            until(lambda: first_contains("Human endpoint: @human_endpoint"))
            until(lambda: first_contains('Queued before a terminal?'))
            first.stdin.write('approve\ny\n'); first.stdin.flush()
            assert early.wait(timeout=60) == 0, early_log.read_text()
            assert components()[shared_name]['status']['container_id'] == shared_id
            print('PASS: a workflow starts before any prompt, queues in dcomp, and completes after a terminal attaches', flush=True)
            alpha = add_worker("alpha")
            alpha_id = components()["alpha"]["status"]["container_id"]
            alpha.submit("human", "review", input={"title": "First question", "prompt": "Approve A?", "candidates": ["alice"],
                "files": [{"label": "Missing job output", "path": "/var/lib/asys/jobs/review/output/board.kicad_pcb"}],
                "context": "Full report A", "form": {"type": "object", "properties": {"approved": {"type": "boolean"}, "comments": {"type": "string"}},
                    "required": ["approved"], "additionalProperties": False}}, metadata={"environment": "alpha"})
            until(lambda: first_contains("Full report A"))
            assert "Full report A" in first_log.read_text()
            document = json.loads(next((temp / "first/human").glob("*/request.json")).read_text())
            files = {entry["role"]: entry for entry in document["files"]}
            assert set(files) == {"workspace"}, files
            assert files["workspace"]["path"] == str(alpha.workspace.resolve())
            assert (Path(files["workspace"]["path"]) / "review.md").read_text().startswith("# alpha project")
            assert files["workspace"]["path"] in first_log.read_text()
            assert "Missing job output" not in first_log.read_text()
            assert "Answer result" not in first_log.read_text()
            assert "Job records" not in first_log.read_text()
            assert document["uischema"]["elements"][0] == {"type": "Label", "text": "First question"}
            beta = add_worker("beta")
            beta.submit("human", "review", input={"title": "Second question", "prompt": "Approve B?", "form": {"type": "boolean"}})
            assert "Approve B?" not in first_log.read_text(), "only one question is presented at a time"
            assert human_state(beta, "review")["status"] == "pending", "queued work must remain unclaimed"
            assert human_state(alpha, "review")["status"] == "claimed", "refresh preserves the current worker claim"
            first.stdin.write("approve\nLooks good.\n"); first.stdin.flush()
            until(lambda: first_contains("Submit response?"))
            assert human_state(alpha, "review")["status"] == "claimed", "editing a form must not complete the task"
            assert human_state(beta, "review")["status"] == "pending", "the next question must wait for submission"
            first.stdin.write("y\n"); first.stdin.flush()
            until(lambda: first_contains("Approve B?"))
            first.stdin.write("disapprove\ny\n"); first.stdin.flush()
            assert alpha.wait("review", timeout=10)["result"] == {"approved": True, "comments": "Looks good."}
            assert beta.wait("review", timeout=10)["result"] is False

            # A workflow-local terminal must not touch the shared global binding
            # or offer its question to this handler.
            global_before = json.loads(run(dcomp, 'view', '--json', system))['globals']
            private_workflow = temp / 'private.bpmn'
            private_workflow.write_text('''<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
              xmlns:asys="urn:asys:workflow:1" targetNamespace="urn:test">
              <bpmn:process id="private" isExecutable="true"><bpmn:userTask id="approval">
                <bpmn:extensionElements><asys:job type="human" input='= {prompt: "Private request?", form: {type: "boolean"}}'/></bpmn:extensionElements>
              </bpmn:userTask></bpmn:process></bpmn:definitions>''')
            private_environment = temp / 'private-environment'
            shutil.copytree(ROOT.parent / 'asys-bpmn/examples/human-prompt/env/human', private_environment)
            (private_environment / 'component.dcomp').write_text('docker asys-human-private-example\n')
            private_log = temp / 'private.log'
            with private_log.open('w') as output:
                private = subprocess.Popen([sys.executable, str(ROOT.parent / 'tools/asys-run'),
                    str(private_environment), str(private_workflow), '--human',
                    '--root', str(temp), '--workspace', str(beta.workspace.resolve()),
                    '--system', system, '--dcomp-state-root', str(temp / 'dcomp')],
                    stdin=subprocess.PIPE, stdout=output, stderr=output, text=True)
            processes.append(private)
            def private_ready():
                assert private.poll() is None, private_log.read_text()
                return 'Private request?' in private_log.read_text()
            until(private_ready, timeout=120)
            assert 'Private request?' not in first_log.read_text()
            assert json.loads(run(dcomp, 'view', '--json', system))['globals'] == global_before
            private.stdin.write('approve\ny\n'); private.stdin.flush()
            assert private.wait(timeout=60) == 0, private_log.read_text()
            record = json.loads(next((temp / 'runs').glob('*/run.json')).read_text())
            assert record['status'] == 'completed' and record['components_removed'], record
            assert record['links']['human'] == record['components']['human'] + '.human'
            assert not (set(record['components'].values()) & set(components()))
            assert json.loads(run(dcomp, 'view', '--json', system))['globals'] == global_before
            print('PASS: --human answers only its workflow, preserves @human_endpoint, and removes its handler on completion', flush=True)

            # Reproduce the reported environment: a human worker whose source
            # manifest incorrectly declares a Human output. Use the shared service.
            terminal_environment = temp / 'terminal-environment'
            shutil.copytree(ROOT.parent / 'asys-bpmn/examples/human-prompt/env/human', terminal_environment)
            source_manifest = 'docker asys-human-terminal-example\noutput asys.human.v1.Human human\n'
            (terminal_environment / 'component.dcomp').write_text(source_manifest)
            shared_workflow = temp / 'shared.bpmn'
            shared_workflow.write_text(private_workflow.read_text().replace('Private request?', 'Shared workflow request?')
                                       .replace('type: "boolean"', 'type: "string"'))
            shared_log = temp / 'shared-workflow.log'
            shared_root = temp / 'shared-state'
            shared_runs = shared_root / 'runs'
            with shared_log.open('w') as output:
                shared = subprocess.Popen([sys.executable, str(ROOT.parent / 'tools/asys-run'),
                    str(terminal_environment), str(shared_workflow), '--root', str(shared_root),
                    '--workspace', str(beta.workspace.resolve()), '--system', system, '--dcomp-state-root', str(temp / 'dcomp')],
                    stdin=subprocess.DEVNULL, stdout=output, stderr=output, text=True)
            processes.append(shared)

            def shared_ready():
                assert shared.poll() is None, shared_log.read_text()
                return first_contains('Shared workflow request?')

            until(shared_ready, timeout=120)
            record = json.loads(next(shared_runs.glob('*/run.json')).read_text())
            assert 'human' not in record['components'], record
            assert record['links']['human'] == '@human_endpoint'
            generated = (shared_runs / record['id'] / 'environment/component.dcomp').read_text()
            assert 'input asys.human.v1.Human human\n' in generated
            assert 'output asys.human.v1.Human human' not in generated
            first.stdin.write('Shared answer\ny\n'); first.stdin.flush()
            assert shared.wait(timeout=60) == 0, shared_log.read_text()
            result = json.loads((shared_runs / record['id'] / 'result.json').read_text())
            assert result['output']['approval'] == 'Shared answer', result
            assert json.loads(run(dcomp, 'view', '--json', system))['globals'] == global_before
            assert not (set(record['components'].values()) & set(components()))
            assert (terminal_environment / 'component.dcomp').read_text() == source_manifest
            print('PASS: a built-in human worker gets its input and uses the existing shared Human service without --human', flush=True)

            # Run the actual CLI and full-screen child in a terminal. Complete a
            # fresh run, then fail a second run and resume it with a new handler.
            config = json.loads((terminal_environment / 'workers.json').read_text())
            config['types']['human']['command'] = ['/bin/sh', '-c',
                '/opt/asys/asys-workers/tools/asys-human || exit $?\n'
                'if [ ! -f reviewed-once ]; then touch reviewed-once; exit 17; fi']
            (terminal_environment / 'workers.json').write_text(json.dumps(config))
            terminal_workspace = temp / 'terminal-workspace'
            terminal_workspace.mkdir()
            (terminal_workspace / 'reviewed-once').touch()
            terminal_workflow = temp / 'terminal.bpmn'
            terminal_workflow.write_text(private_workflow.read_text().replace('Private request?', 'Terminal request?')
                                         .replace('type: "boolean"', 'type: "string"'))
            terminal_root = temp / 'terminal-state'
            terminal_runs = terminal_root / 'runs'
            arguments = [str(terminal_environment), str(terminal_workflow), '--human',
                '--root', str(terminal_root), '--workspace', str(terminal_workspace),
                '--system', system, '--dcomp-state-root', str(temp / 'dcomp')]
            for attempt, expected_exit in [(1, 0), (2, 1), (3, 0)]:
                master, slave = pty.openpty()
                fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 40, 120, 0, 0))
                original_terminal = termios.tcgetattr(slave)
                os.set_blocking(master, False)
                transcript = bytearray()
                process = subprocess.Popen([sys.executable, str(ROOT.parent / 'tools/asys-run'), *arguments],
                    stdin=slave, stdout=slave, stderr=slave, start_new_session=True,
                    env={**os.environ, 'TERM': 'xterm-256color'})
                processes.append(process)

                def drain_terminal():
                    while True:
                        try:
                            data = os.read(master, 65536)
                        except BlockingIOError:
                            return
                        if not data:
                            return
                        transcript.extend(data)

                def terminal_ready():
                    drain_terminal()
                    assert process.poll() is None, transcript.decode(errors='replace')
                    return b'Terminal request?' in transcript and b'Review the request' in transcript

                def terminal_finished():
                    drain_terminal()
                    return process.poll() is not None

                try:
                    until(terminal_ready, timeout=120)
                    assert b'\x1b[?1049h' in transcript, 'the child must use the full-screen TUI'
                    assert json.loads(run(dcomp, 'view', '--json', system))['globals'] == global_before
                    assert 'Terminal request?' not in first_log.read_text()
                    state_file = max(terminal_runs.glob('*/run.json'), key=lambda path: path.stat().st_mtime)
                    record = json.loads(state_file.read_text())
                    running = components()
                    worker = running[record['components']['workers']]
                    assert record['components']['human'] in running
                    assert any(port['name'] == 'human' and port['service'] == 'asys.human.v1.Human'
                               for port in worker['inputs'])
                    assert not any(port['name'] == 'human' for port in worker['outputs'])
                    assert record['links']['human'] == record['components']['human'] + '.human'
                    session_file = max((terminal_root / 'human').glob('*/session.json'), key=lambda path: path.stat().st_mtime)
                    assert json.loads(session_file.read_text())['global'] is None
                    # F4 focuses the response editor; Ctrl-S explicitly submits.
                    os.write(master, b'\x1bOS')
                    time.sleep(0.2)
                    answer = f'Terminal answer {attempt}'
                    os.write(master, answer.encode())
                    time.sleep(0.2)
                    os.write(master, b'\x13')
                    until(terminal_finished, timeout=90)
                    drain_terminal()
                    assert process.returncode == expected_exit, transcript.decode(errors='replace')
                    assert termios.tcgetattr(slave) == original_terminal, 'the TUI must restore terminal settings'
                    assert b'\x1b[?1049l' in transcript, 'the TUI must leave the alternate screen'
                    assert b'RUN FAILED' not in transcript and b'RUN COMPLETED' not in transcript, 'workflow progress must not overwrite the TUI'
                    record = json.loads(state_file.read_text())
                    assert record['status'] == ('failed' if expected_exit else 'completed'), record
                    assert record['components_removed'], record
                    assert not (set(record['components'].values()) & set(components()))
                    assert json.loads(run(dcomp, 'view', '--json', system))['globals'] == global_before
                    assert (terminal_environment / 'component.dcomp').read_text() == source_manifest
                    if expected_exit == 0:
                        result = json.loads((state_file.parent / 'result.json').read_text())
                        assert result['output']['approval'] == answer, result
                    if attempt == 1:
                        (terminal_workspace / 'reviewed-once').unlink()
                    else:
                        arguments = ['--resume', record['id'], '--human', '--root', str(terminal_root)]
                finally:
                    if process.poll() is None:
                        process.terminate()
                        try:
                            until(terminal_finished, timeout=30)
                        finally:
                            if process.poll() is None:
                                process.kill()
                                process.wait(timeout=10)
                    drain_terminal()
                    (temp / f'terminal-{attempt}.log').write_bytes(transcript)
                    os.close(master)
                    os.close(slave)
            print('PASS: --human run and resume add the worker input, answer through a real terminal, restore it, and leave the shared Human service unchanged', flush=True)

            # Install a changed service image, then refresh through its owning
            # terminal. Worker identities and the global name must stay intact.
            upgrade = temp / 'upgrade'
            upgrade.mkdir()
            (upgrade / 'Dockerfile').write_text(f'FROM {human_image}\nLABEL asys.update.test=changed\n')
            run(['docker'], 'build', '-t', human_image, str(upgrade))
            install_human()
            old_components = components()
            shared = shared_name
            update = [sys.executable, str(ROOT.parent / 'tools/asys'), 'update', '--root', str(temp / 'first')]
            run(update)
            refreshed = components()
            assert refreshed[shared]['status']['container_id'] != old_components[shared]['status']['container_id']
            for name in ('alpha', 'beta'):
                assert refreshed[name]['status']['container_id'] == old_components[name]['status']['container_id']
            assert json.loads(run(dcomp, 'view', '--json', system))['globals'] == global_before
            run(update)
            assert components()[shared]['status']['container_id'] == refreshed[shared]['status']['container_id']
            alpha.submit('human', 'updated', input={'prompt': 'Question after update?', 'form': {'type': 'boolean'}})
            until(lambda: first_contains('Question after update?'))
            first.stdin.write('approve\ny\n'); first.stdin.flush()
            assert alpha.wait('updated', timeout=10)['result'] is True
            print('PASS: asys update refreshes the shared Human image through its owner and leaves workers and current images alone', flush=True)

            first.stdin.close()
            assert first.wait(timeout=30) == 0, first_log.read_text()
            current = components()
            assert set(current) == {"alpha", "beta", shared_name}
            assert current["alpha"]["status"]["container_id"] == alpha_id
            before = {name: item["status"]["container_id"] for name, item in current.items()}
            print("PASS: workers use @human_endpoint; one service queues colliding job IDs and records approve/disapprove through Human RPC", flush=True)

            second, second_log, second_contains = launch("interrupt")
            until(lambda: second_contains("Human endpoint: @human_endpoint"))
            alpha.submit("human", "text", input={"prompt": "Explain the decision?"})
            until(lambda: second_contains("Answer: "))
            second.send_signal(signal.SIGTERM)
            assert second.wait(timeout=30) == 130, second_log.read_text()
            until(lambda: human_state(alpha, 'text')['status'] == 'pending')
            assert set(components()) == {"alpha", "beta", shared_name}
            third, third_log, third_contains = launch("retry", ["--once"])
            until(lambda: third_contains("Human endpoint: @human_endpoint"))
            until(lambda: third_contains("Answer: "))
            third.stdin.write("The report needs revision.\ny\n"); third.stdin.flush()
            assert third.wait(timeout=30) == 0, third_log.read_text()
            assert alpha.wait("text", timeout=10)["result"] == "The report needs revision."
            assert {name: item["status"]["container_id"] for name, item in components().items()} == before
            print("PASS: disconnecting and reconnecting the prompt preserves the service and completes the original waiting job", flush=True)

            # Also recover an abandoned claim after an uncatchable terminal
            # exit. No replacement job or worker restart is allowed.
            killed, killed_log, killed_contains = launch('killed')
            until(lambda: killed_contains('Human endpoint: @human_endpoint'))
            alpha.submit('human', 'abandoned', input={'prompt': 'Recover this claim?'})
            until(lambda: killed_contains('Answer: '))
            killed.kill()
            assert killed.wait(timeout=10) == -signal.SIGKILL
            recovered, recovered_log, recovered_contains = launch('recovered', ['--once'])
            until(lambda: recovered_contains('Recover this claim?'))
            recovered.stdin.write('Recovered answer\ny\n'); recovered.stdin.flush()
            assert recovered.wait(timeout=30) == 0, recovered_log.read_text()
            assert alpha.wait('abandoned', timeout=10)['result'] == 'Recovered answer'
            assert {name: item['status']['container_id'] for name, item in components().items()} == before
            print('PASS: reconnecting after SIGKILL recovers the abandoned claim and completes the same job', flush=True)

            fourth, fourth_log, fourth_contains = launch("cancellation")
            until(lambda: fourth_contains("Human endpoint: @human_endpoint"))
            alpha.submit("human", "cancel-me", input={"prompt": "This question will be cancelled"})
            until(lambda: fourth_contains("Answer: "))
            alpha.cancel("cancel-me")
            assert alpha.wait("cancel-me", timeout=10)["status"] == "cancelled"
            beta.submit("human", "count", input={"prompt": "Enter an even count", "form": {"type": "object", "properties": {"count": {"type": "integer", "multipleOf": 2}},
                "required": ["count"], "additionalProperties": False}})
            fourth.stdin.write("Late answer\ny\n"); fourth.stdin.flush()
            until(lambda: fourth_contains("Count: "))
            fourth.stdin.write("wrong type\n"); fourth.stdin.flush()
            until(lambda: fourth_contains("Enter a whole number."))
            fourth.stdin.write("3\ny\n"); fourth.stdin.flush()
            until(lambda: fourth_contains("Result does not match task form"))
            fourth.stdin.write("2\ny\n"); fourth.stdin.flush()
            assert beta.wait("count", timeout=10)["result"] == {"count": 2}

            alpha.submit("human", "graphical-only", input={"prompt": "A form with a conditional UI rule", "form": {"type": "boolean"},
                "uischema": {"type": "Control", "scope": "#", "rule": {"effect": "HIDE", "condition": {"scope": "#", "schema": {"const": False}}}}})
            until(lambda: fourth_contains("Cannot render this form:"))
            until(lambda: human_state(alpha, "graphical-only")["status"] == "pending")

            beta.submit("human", "ui-review", input={"prompt": "Review with JSON Forms", "form": {"type": "object", "properties": {
                "approved": {"type": "boolean", "oneOf": [{"const": True, "title": "Accept"}, {"const": False, "title": "Request changes"}]},
                "comments": {"type": "string"}}, "required": ["approved"], "additionalProperties": False},
                "uischema": {"type": "Group", "label": "Design review", "elements": [
                    {"type": "Control", "scope": "#/properties/comments", "label": "Reviewer note", "options": {"multi": True}},
                    {"type": "Control", "scope": "#/properties/approved", "label": "Decision", "options": {"format": "radio"}}]}})
            until(lambda: fourth_contains("Reviewer note ("))
            fourth.stdin.write("Move the connector.\nKeep the test point.\n/done\n2\ny\n"); fourth.stdin.flush()
            assert beta.wait("ui-review", timeout=10)["result"] == {"comments": "Move the connector.\nKeep the test point.", "approved": False}

            # Exact schema from pcb-engineer's waiting human request. A rejection
            # must retain the claim until the worker accepts a nonblank comment.
            approval = json.loads((ROOT / "test/fixtures/pcb-approval.json").read_text())
            alpha.submit("human", "pcb-reject", input=approval)
            until(lambda: fourth_contains("Approve the PCB design"))
            rejected = fourth_log.read_text().count("Answer rejected:")
            fourth.stdin.write("disapprove\n\ny\n"); fourth.stdin.flush()
            until(lambda: fourth_log.read_text().count("Answer rejected:") > rejected)
            assert human_state(alpha, "pcb-reject")["status"] == "claimed"
            rejected = fourth_log.read_text().count("Answer rejected:")
            fourth.stdin.write("\n   \ny\n"); fourth.stdin.flush()
            until(lambda: fourth_log.read_text().count("Answer rejected:") > rejected)
            assert human_state(alpha, "pcb-reject")["status"] == "claimed"
            fourth.stdin.write("\nMove the connector.\ny\n"); fourth.stdin.flush()
            assert alpha.wait("pcb-reject", timeout=10)["result"] == {"approved": False, "comments": "Move the connector."}

            beta.submit("human", "pcb-approve", input={**approval, "title": "PCB approval without a comment"})
            until(lambda: fourth_contains("PCB approval without a comment"))
            fourth.stdin.write("approve\n\ny\n"); fourth.stdin.flush()
            assert beta.wait("pcb-approve", timeout=10)["result"] == {"approved": True}
            assert "Schema combinations" not in fourth_log.read_text()
            print("PASS: pcb-engineer's anyOf form renders; the worker rejects missing/blank rejection comments and accepts corrections or approval without a comment", flush=True)
            assert "JSON answer" not in fourth_log.read_text()
            fourth.stdin.close()
            assert fourth.wait(timeout=30) == 0, fourth_log.read_text()
            assert {name: item["status"]["container_id"] for name, item in components().items()} == before
            print("PASS: cancellation and unsupported forms do not stop the queue; worker validation permits correction; JSON Forms controls collect multiline comments and decisions", flush=True)

            # Exercise the actual full-screen host with real Human RPC. Pilot
            # drives only this isolated system, never a user's waiting request.
            sys.path[:0] = [str(ROOT / ".host-deps"), str(ROOT / "python")]
            from asys_human.interaction import Interaction
            from asys_human.launcher import Launcher, arguments, run_handler
            from asys_human.tui import HumanApp
            from asys_human.tui_forms import FieldEditor
            from textual.widgets import DirectoryTree, RadioButton, Static
            from asys_human.tui_files import FilesView

            interaction = Interaction()
            launcher = Launcher(arguments(["--system", system, "--dcomp-state-root", str(temp / "dcomp"),
                "--root", str(temp / "tui"), "--claimant", "alice"]), interaction)
            app = HumanApp(interaction, lambda: run_handler(launcher), claimant="alice", system=system)

            async def terminal_test():
                async with app.run_test(size=(120, 40)) as pilot:
                    async def wait_for(check):
                        deadline = time.monotonic() + 60
                        while time.monotonic() < deadline:
                            if check():
                                return
                            await pilot.pause(0.05)
                        raise AssertionError("Timed out waiting for the terminal handler")

                    await wait_for(lambda: launcher.next_discovery and any(g['name'] == 'human_endpoint' and g.get('target', {}).get('component') == launcher.name for g in launcher.topology.get('globals', [])))
                    beta.submit("human", "tui-reject", input=approval)
                    await wait_for(lambda: app.document and app.document["task"] == "beta.tui-reject" and not app.submitting)
                    await pilot.press("f3")
                    files = app.query_one(FilesView)
                    assert files.location == beta.workspace.resolve()
                    assert files.query_one(DirectoryTree).path == beta.workspace.resolve()
                    approved = next(field for field in app.query(FieldEditor) if field.node.path == ("approved",))
                    comment = next(field for field in app.query(FieldEditor) if field.node.path == ("comments",)).editor
                    await pilot.press("f4")
                    await pilot.click(approved.editor.query(RadioButton)[1])
                    await pilot.press("ctrl+s")
                    await wait_for(lambda: not app.submitting and bool(str(app.query_one("#answer-error", Static).content)))
                    assert human_state(beta, "tui-reject")["status"] == "claimed"
                    comment.load_text("Rotate the connector.\nKeep its pads inside the board.")
                    await pilot.press("ctrl+s")
                    await wait_for(lambda: human_state(beta, "tui-reject")["status"] == "completed")
                    assert beta.wait("tui-reject", timeout=10)["result"] == {
                        "approved": False, "comments": "Rotate the connector.\nKeep its pads inside the board."}
                    beta.submit("human", "tui-release", input={"prompt": "Leave this request pending"})
                    await wait_for(lambda: app.document and app.document["task"] == "beta.tui-release" and not app.submitting)
                    assert human_state(beta, "tui-release")["status"] == "claimed"
                    await pilot.press("ctrl+q")
                    await wait_for(lambda: not app.backend.is_alive())

            try:
                asyncio.run(terminal_test())
            finally:
                interaction.stopping.set()
                if app.backend:
                    app.backend.join(timeout=60)
            until(lambda: human_state(beta, 'tui-release')['status'] == 'pending')
            beta.cancel('tui-release')
            assert beta.wait('tui-release', timeout=10)['status'] == 'cancelled'
            assert not launcher.owned and launcher.active is None
            assert {name: item["status"]["container_id"] for name, item in components().items()} == before
            print("PASS: full-screen TUI submits the actual PCB form, preserves worker-validation retries, follows the queue, and releases its claim on quit", flush=True)

            # Verify installed entry points and the install/update sequence,
            # using a real (empty) inference installation and no terminal.
            prefix = temp / 'installed'
            run(['make'], '-C', str(ROOT), 'install-host', f'PREFIX={prefix}')
            run(['make'], '-C', str(ROOT.parent / 'asys-inference'), 'install', f'PREFIX={prefix}')
            installation = temp / 'updated-state'
            inference = [str(prefix / 'bin/asys-inference'), '--root', str(installation)]
            run(inference, 'init', '--empty', '--system', update_system, '--dcomp-state-root', str(temp / 'dcomp'))
            run(inference, 'start')
            installed_update = [str(prefix / 'bin/asys'), 'update', '--root', str(installation)]
            run(installed_update)
            def installed_service():
                view = json.loads(run(dcomp, 'view', '--json', update_system))
                assert any(g['name'] == 'human_endpoint' and g['target']['component'] == 'asys-human' for g in view['globals'])
                item = next(item for item in view['components'] if item['name'] == 'asys-human')
                assert item['status']['health'] == 'healthy', item
                return item['status']['container_id']
            installed_id = installed_service()
            assert not list((installation / 'human').glob('*/session.json'))
            run(installed_update)
            assert installed_service() == installed_id, 'unchanged image must keep its container'
            result = subprocess.run([str(prefix / 'bin/asys-human-prompt'), '--plain', '--system', update_system,
                                     '--root', str(installation), '--dcomp-state-root', str(temp / 'dcomp')],
                                    input='', capture_output=True, text=True, timeout=30)
            assert result.returncode == 0, result.stdout + result.stderr
            assert installed_service() == installed_id, 'EOF must detach without stopping the service'
            print('PASS: freshly installed asys update starts a healthy Human component without a prompt; repeat update and prompt EOF preserve it', flush=True)
            (ROOT / "integration-failure.log").unlink(missing_ok=True)
        except BaseException:
            with log.open("a") as output:
                for path in temp.glob("*.log"):
                    if path != log:
                        output.write(f"\n{path.name}\n{path.read_text()}")
            shutil.copyfile(log, ROOT / "integration-failure.log")
            raise
        finally:
            for process in processes:
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=30)
                    except subprocess.TimeoutExpired:
                        process.kill(); process.wait()
                if process.stdin and not process.stdin.closed:
                    process.stdin.close()
            subprocess.run(dcomp + ["down", system], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
            subprocess.run(dcomp + ['down', update_system], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
            subprocess.run(['docker', 'image', 'rm', human_image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)


